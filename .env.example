# 실제 값은 .env 에만 두세요. 이 파일에는 변수 이름만 둡니다.
# (PreToolUse 훅이 이 파일에 값이 기록되는 것을 차단합니다)

# mock | anthropic | openai   (기본값 mock — 키 없이도 전체 데모가 동작해야 함)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# 선택 사항: 설정되지 않으면 메모리/JSON fallback 으로 동작
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# 프론트엔드가 바라볼 백엔드 주소 (예: http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=

# 배포한 프론트엔드 주소. 백엔드가 CORS 로 허용할 출처이며 쉼표로 여러 개를 둘 수 있다.
# localhost:3000 / 3001 은 설정과 무관하게 항상 허용된다.
ALLOWED_ORIGINS=
